FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    MLFORGE_HOSTED_DEMO=1 \
    MLFORGE_HOME=/tmp/mlforge \
    PORT=80

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-lock.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt -c requirements-lock.txt
COPY mlforge ./mlforge
COPY app ./app
COPY .streamlit ./.streamlit
COPY streamlit_app.py ./
COPY scripts/serve_hosted.py ./scripts/serve_hosted.py

EXPOSE 80
CMD ["python", "scripts/serve_hosted.py"]
